
/* Adaa Collection Pages */

.adaa-navbar {
    background-color: #570D2B;
    padding: 15px 0;
}

.product-card {
    border: none;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.10);
    transition: transform 0.3s ease;
}

.product-card:hover {
    transform: translateY(-5px);
}

.product-card img {
    width: 100%;
    height: 280px;
    object-fit: cover;
}

.product-card h5 {
    color: #570D2B;
    font-size: 17px;
}

.product-card p {
    color: #35101F;
    font-weight: bold;
}

@media (max-width: 576px) {
    .product-card img {
        height: 180px;
    }

    .product-card h5 {
        font-size: 14px;
    }
}
/* Homepage Category Layout */

#categories .row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

#categories .row > div {
    width: 100%;
    padding: 0;
}

#categories .category-card {
    height: 100%;
}

#categories .category-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
}